{
  "name": "@uapkg/package-manifest",
  "version": "1.5.0",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/uapkg/uapkg.git",
    "directory": "packages/uapkg-package-manifest"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "vp pack",
    "prepack": "vp run build",
    "build:watch": "vp pack --watch"
  },
  "dependencies": {
    "@uapkg/common": "workspace:^",
    "@uapkg/common-schema": "workspace:^",
    "@uapkg/config": "workspace:^",
    "@uapkg/diagnostics": "workspace:^",
    "@uapkg/package-manifest-schema": "workspace:^",
    "@uapkg/registry-core": "workspace:^",
    "semver": "7.7.1"
  },
  "devDependencies": {
    "@types/semver": "7.7.0"
  },
  "imports": {
    "#package-manifest/*.ts": {
      "uapkg-source": "./src/*.ts",
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  }
}
