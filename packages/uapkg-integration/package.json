{
  "name": "@uapkg/integration",
  "version": "1.7.5",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/uapkg/uapkg.git",
    "directory": "packages/uapkg-integration"
  },
  "files": [
    "dist",
    "licenses",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "default": "./dist/runtime.js"
    }
  },
  "scripts": {
    "build": "vp pack",
    "prepack": "vp run build",
    "build:watch": "vp pack --watch"
  },
  "dependencies": {
    "@lumis-sh/wasm-csharp": "0.26.7",
    "web-tree-sitter": "0.26.10",
    "zod": "4.3.6"
  },
  "imports": {
    "#integration/*.ts": {
      "uapkg-source": "./src/*.ts",
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  }
}
