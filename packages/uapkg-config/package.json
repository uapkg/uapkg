{
  "name": "@uapkg/config",
  "version": "1.4.0",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/uapkg/uapkg.git",
    "directory": "packages/uapkg-config"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "vp pack",
    "prepack": "vp run build",
    "build:watch": "vp pack --watch"
  },
  "dependencies": {
    "@uapkg/common": "workspace:^",
    "@uapkg/common-schema": "workspace:^",
    "@uapkg/diagnostics": "workspace:^"
  },
  "devDependencies": {
    "zod": "4.3.6"
  },
  "peerDependencies": {
    "zod": "^4.3.6"
  },
  "imports": {
    "#config/*.ts": {
      "uapkg-source": "./src/*.ts",
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  }
}
