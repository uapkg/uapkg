{
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "change": "changeset",
    "release": "vp exec node tools/release/publishRelease.ts",
    "release:prepare": "vp exec node tools/release/runRelease.ts prepare-npm",
    "release:native": "vp exec node tools/release/runRelease.ts build-native",
    "release:smoke-native": "vp exec node tools/release/runRelease.ts smoke-native",
    "release:smoke-npm": "vp exec node tools/release/runRelease.ts smoke-npm",
    "release:assemble": "vp exec node tools/release/runRelease.ts assemble",
    "release:select-native": "vp exec node tools/release/runRelease.ts select-native",
    "prepare": "vp config --hooks-dir .vite-hooks --no-agent",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "lint": "vp lint",
    "build": "vp exec node tools/dev-build/runDevBuild.ts build",
    "build:link": "vp exec node tools/dev-build/runDevBuild.ts link",
    "build:watch": "vp exec node tools/dev-build/runDevBuild.ts watch",
    "build:unlink": "vp exec node tools/dev-build/runDevBuild.ts unlink",
    "build:status": "vp exec node tools/dev-build/runDevBuild.ts status",
    "build:clean": "vp exec node tools/dev-build/runDevBuild.ts clean",
    "clean:all": "vp exec node tools/dev-build/runDevBuild.ts cleanAll",
    "consumer:bundle": "vp exec node tools/consumer-bundle/runConsumerBundle.ts",
    "deps:consumer-bundle": "vp run consumer:bundle",
    "typecheck": "vp check --no-fmt --no-lint",
    "launcher:build": "vp exec node tools/launcher/runCargo.ts build --release --locked",
    "launcher:test": "vp exec node tools/launcher/runCargo.ts test --locked",
    "launcher:smoke-development": "vp exec node tools/dev-build/runNativeSmoke.ts",
    "launcher:lint": "vp exec node tools/launcher/runCargo.ts clippy --all-targets --all-features --locked",
    "launcher:format": "vp exec node tools/launcher/runCargo.ts fmt --all",
    "launcher:format:check": "vp exec node tools/launcher/runCargo.ts fmt --all --check",
    "test": "vp test run",
    "coverage": "vp test run --coverage",
    "verify": "vp check && vp test run"
  },
  "devDependencies": {
    "@changesets/changelog-github": "0.6.0",
    "@changesets/cli": "2.30.0",
    "@types/node": "26.2.0",
    "@types/semver": "7.7.0",
    "@vitest/coverage-v8": "catalog:",
    "semver": "7.7.1",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vite-plus": "catalog:"
  },
  "dependencies": {
    "dotenv": "17.4.1"
  },
  "engines": {
    "node": ">=22"
  }
}
