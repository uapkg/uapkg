    "origins": {
      "launcher.defaultCliVersion": "default",
      "launcher.autoLauncherUpdate": "default",
      "launcher.autoCLIUpdate": "local",
      "launcher.autoUpdate.minimumReleaseAge": "default"
    },
    "ignored": []
  },
  {
    "name": "nearest manifest is the boundary regardless of kind",
    "cwd": "project/plugin/nested",
    "manifests": ["project/uapkg.json", "project/plugin/uapkg.json"],
    "files": {
      "project/.uapkg/config.json": "{\"launcher\":{\"defaultCliVersion\":\"9.0.0\"}}",
      "project/plugin/.uapkg/config.json": "{\"launcher\":{\"defaultCliVersion\":\"2.0.0-alpha\"}}"
    },
    "expected": {
      "launcher": {
        "defaultCliVersion": "2.0.0-alpha",
        "autoLauncherUpdate": true,
        "autoCLIUpdate": true,
        "autoUpdate": {
          "minimumReleaseAge": "3d"
        }
      }
    },
    "origins": {
      "launcher.defaultCliVersion": "intermediary",
      "launcher.autoLauncherUpdate": "default",
      "launcher.autoCLIUpdate": "default",
      "launcher.autoUpdate.minimumReleaseAge": "default"
    },
    "ignored": []
  },
  {
    "name": "nested minimum release age walks all config layers",
    "cwd": "project/area/nested",
    "manifests": ["project/uapkg.json"],
    "files": {
      "profile/config.json": "{\"launcher\":{\"autoUpdate\":{\"minimumReleaseAge\":\"1w\"}}}",
      "project/.uapkg/config.json": "{\"launcher\":{\"autoUpdate\":{\"minimumReleaseAge\":\"2d\"}}}",
      "project/area/.uapkg/config.json": "{\"launcher\":{\"autoUpdate\":{\"minimumReleaseAge\":\"1h30m\"}}}",
      "project/area/nested/.uapkg/config.json": "{\"launcher\":{\"autoUpdate\":{\"minimumReleaseAge\":\"15m\"},\"autoCLIUpdate\":false}}"
    },
    "expected": {
      "launcher": {
        "defaultCliVersion": "latest",
        "autoLauncherUpdate": true,
        "autoCLIUpdate": false,
        "autoUpdate": {
          "minimumReleaseAge": "15m"
        }
      }
    },
    "origins": {
      "launcher.defaultCliVersion": "default",
      "launcher.autoLauncherUpdate": "default",
      "launcher.autoCLIUpdate": "local",
      "launcher.autoUpdate.minimumReleaseAge": "local"
    },
    "ignored": []
  },
