    "origins": {
      "launcher.defaultCliVersion": "default",
      "launcher.autoLauncherUpdate": "default",
      "launcher.autoCLIUpdate": "local",
      "launcher.autoUpdate.minimumReleaseAge": "global"
    },
    "ignored": ["launcher.autoUpdate.minimumReleaseAge"]
  },
